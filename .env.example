# =============================================================================
# JARVAS — example environment configuration
# Copy to .env and change every secret before deploying anywhere.
# =============================================================================

# ---- General -----------------------------------------------------------------
JARVAS_ENV=development
JARVAS_LOG_LEVEL=INFO

# ---- Database ----------------------------------------------------------------
# Postgres + pgvector is required for production recognition (ANN search).
# If left empty the backend falls back to a local SQLite file for development.
DATABASE_URL=postgresql+psycopg://jarvas:jarvas@postgres:5432/jarvas
POSTGRES_USER=jarvas
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=jarvas

# ---- Redis (Celery broker + cache) ------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Auth / OIDC -------------------------------------------------------------
# HS256 signing secret for locally-issued JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional external OIDC provider (Keycloak, Auth0, Entra, Google...).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---- Bootstrap admin (created on first boot in development) ------------------
BOOTSTRAP_ADMIN_EMAIL=admin@jarvas.dev
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_TENANT_NAME=JARVAS Demo Tenant

# ---- Biometric embedding encryption at rest ---------------------------------
# Fernet key (32 urlsafe-base64 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=

# ---- Object storage (S3-compatible) -----------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=jarvas
S3_SECRET_KEY=change-me-minio
S3_BUCKET_UPLOADS=jarvas-uploads
S3_BUCKET_RESULTS=jarvas-results
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# In development, use a local filesystem store instead of S3 (no MinIO needed).
STORAGE_BACKEND=s3

# ---- AI / models -------------------------------------------------------------
# Comma-separated InsightFace model packs. detection=SCRFD, recognition=ArcFace.
FACE_DETECTION_MODEL=buffalo_sc
FACE_RECOGNITION_MODEL=buffalo_sc
FACE_PROVIDERS=CPUExecutionProvider
FACE_DET_SIZE=640
FACE_EMBEDDING_DIM=512
MODEL_DIR=/models
# If model weights are absent, the engine uses a deterministic mock so the app runs.
ALLOW_MOCK_FACE_ENGINE=true

# Default cosine-similarity threshold for a "candidate" match (calibrate per use).
DEFAULT_SIMILARITY_THRESHOLD=0.38
# Minimum face box (px) accepted by quality gate.
MIN_FACE_SIZE=80
# Launch Settings / recognition are disabled unless true.
RECOGNITION_ENABLED=true

# ---- Video pipeline ----------------------------------------------------------
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_UPLOAD_MB=512
VIDEO_DEFAULT_SAMPLE_FPS=1

# ---- Retention / limits ------------------------------------------------------
DEFAULT_RETENTION_DAYS=180
MAX_UPLOAD_MB=25
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=JARVAS
